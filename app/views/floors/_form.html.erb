<%= form_with(model: floor) do |form| %>
  <%= render "layouts/form_errors", object: form.object %> 
  
  <div>
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :home_id, style: "display: block" %>
    <%= form.collection_select :home_id, Home.all, :id, :name, prompt: "Select a home" %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
