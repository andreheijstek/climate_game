<%= form_with(model: room) do |form| %>
  <%= render "layouts/form_errors", object: form.object %>

  <div>
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :floor_id, style: "display: block" %>
    <%= form.collection_select :floor_id, Floor.all, :id, :name, prompt: "Select a floor" %>
  </div>
  
  <div>
    <%= form.submit %>
  </div>
<% end %>
